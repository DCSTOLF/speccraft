# Helper binaries — populated by install-binaries.sh at runtime
bin/*
!bin/.gitkeep
.binary-version
.binary-provenance

# Runtime state — machine state, not project intent
.speccraft/state.json
# Ledger write-lock sidecar (spec 0045) — advisory flock file, never project intent
.speccraft/ledger.lock

# Claude Code local settings — machine-local permission allowlists, not project intent
.claude/

# Devcontainer local env (auth tokens, secrets)
.env.devcontainer

# E2E test logs
tests/e2e/.logs/

# Go build artifacts
tools/bin/
